# The game's runtime options (ua_host: docs/runtime.md and docs/input.md in portmaster-unity),
# sourced by the launcher. Edit to taste; a variable already set in the environment wins.
[ -n "${UA_PAD_NAME+x}" ] || export UA_PAD_NAME='Nintendo Switch Pro Controller'
[ -n "${UA_JIT_WARM+x}" ] || export UA_JIT_WARM='1'
[ -n "${UA_GL_PERSIST+x}" ] || export UA_GL_PERSIST='1'
[ -n "${UA_GL_ARENA+x}" ] || export UA_GL_ARENA='1'
# handhelds with 1 GB of RAM or less: a smaller picture, the same game (set a variable above, or
# in the environment, e.g. to "" or "full", and that wins)
mem_mb=$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo 2>/dev/null)
if [ "${mem_mb:-0}" -gt 0 ] && [ "${mem_mb:-0}" -le 1024 ]; then
  [ -n "${ASMPATCH_HK_BLUR+x}" ] || export ASMPATCH_HK_BLUR=off
  [ -n "${UA_RENDER_SIZE+x}" ] || export UA_RENDER_SIZE=540x360
  [ -n "${UA_GFX_JOBS+x}" ] || export UA_GFX_JOBS=legacy
  [ -n "${UA_AUDIO_RATE+x}" ] || export UA_AUDIO_RATE=24000
fi
